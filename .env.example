# API Configuration
REACT_APP_API_BASE_URL=http://localhost:3000
REACT_APP_API_TIMEOUT=30000
REACT_APP_GAMECHANGRR_API_URL=http://localhost:3000/api

# Energy Star API
REACT_APP_ENERGY_STAR_API_URL=https://portfoliomanager.energystar.gov/wsapiservice
REACT_APP_ENERGY_STAR_USERNAME=your_username
REACT_APP_ENERGY_STAR_PASSWORD=your_password

# Cache Configuration
REACT_APP_CACHE_TTL=300000
REACT_APP_CACHE_MAX_SIZE=1000

# Feature Flags
REACT_APP_ENABLE_MOCK_DATA=true
REACT_APP_ENABLE_CACHING=true
REACT_APP_ENABLE_API_LOGGING=false

# Rate Limits
REACT_APP_API_RATE_LIMIT=100
REACT_APP_API_RATE_WINDOW=60000

# Utility Providers API
REACT_APP_UTILITY_API_KEY=your_utility_api_key
REACT_APP_UTILITY_API_SECRET=your_utility_api_secret 