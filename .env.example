# API Keys
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_CENSUS_API_KEY=your_census_api_key_here
VITE_NREL_API_KEY=your_nrel_api_key_here
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_REGRID_API_KEY=your_regrid_api_key_here

# API URLs
VITE_API_URL=http://localhost:5174

# Feature Flags
VITE_USE_MOCK_DATA=true # Set to false in production
VITE_ENABLE_WEATHER=true
VITE_ENABLE_SOLAR=true
VITE_ENABLE_PROPERTY=true 